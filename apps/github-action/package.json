{
  "name": "@bytesmith/github-action",
  "version": "0.1.0",
  "private": true,
  "description": "Advisory ByteSmith Verify pull-request integration",
  "type": "module",
  "exports": "./dist/index.js",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "bundle": "tsc -b tsconfig.json && ncc build dist/index.js --out dist/bundle -m -a && node scripts/finalize-bundle.mjs",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "@actions/core": "1.11.1",
    "@bytesmith/analysis-engine": "workspace:*",
    "@bytesmith/impact-manifest": "workspace:*",
    "@bytesmith/vcs-git": "workspace:*"
  },
  "devDependencies": {
    "@vercel/ncc": "0.38.3"
  }
}
